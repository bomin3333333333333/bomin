<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>토끼의 기후 탐험 🐰</title>
<link href="https://fonts.googleapis.com/css2?family=Gaegu:wght@400;700&family=Noto+Sans+KR:wght@400;500;700;900&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--green:#5DBE5E;--green-d:#3d9e3e;--text:#3a3020;--mid:#6b5e42;--orange:#E8862A;}
body{font-family:'Noto Sans KR',sans-serif;background:#87CEEB;width:100vw;height:100vh;overflow:hidden;position:relative;}

/* ── 화면 시스템 ── */
.screen{display:none;position:absolute;inset:0;flex-direction:column;align-items:center;justify-content:center;}
.screen.active{display:flex;}

/* ════ MAP ════ */
#s-map{align-items:stretch;justify-content:flex-start;}
.map-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
.pin{position:absolute;width:56px;cursor:pointer;transform:translateX(-50%);transform-origin:bottom center;animation:pinBounce 2s ease-in-out infinite;filter:drop-shadow(0 6px 14px rgba(0,0,0,.35));z-index:20;}
.pin:hover{animation-play-state:paused;transform:translateX(-50%) scale(1.18);}
.pin:nth-child(1){animation-delay:0s}.pin:nth-child(2){animation-delay:.35s}.pin:nth-child(3){animation-delay:.7s}.pin:nth-child(4){animation-delay:1.05s}.pin:nth-child(5){animation-delay:1.4s}.pin:nth-child(6){animation-delay:.2s}
@keyframes pinBounce{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(-12px)}}
.rabbit-wrap{position:fixed;bottom:24px;right:24px;z-index:100;display:flex;flex-direction:column;align-items:flex-end;gap:10px;}
.rabbit-btn{width:80px;height:80px;border-radius:50%;overflow:hidden;border:3px solid #fff;box-shadow:0 6px 24px rgba(0,0,0,.24);cursor:pointer;animation:rFloat 3s ease-in-out infinite;}
.rabbit-btn img{width:100%;height:100%;object-fit:cover;}
@keyframes rFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
.map-bubble{background:#fff;border-radius:18px;padding:12px 16px;font-size:.8rem;font-weight:700;color:var(--text);box-shadow:0 4px 18px rgba(0,0,0,.14);line-height:1.6;max-width:188px;text-align:center;position:relative;}
.map-bubble::after{content:'';position:absolute;bottom:-10px;right:30px;border:6px solid transparent;border-top-color:#fff;border-bottom:none;}
.collect-btn{position:fixed;bottom:42px;right:122px;background:var(--green);color:#fff;font-weight:900;font-size:1rem;border:none;border-radius:50px;padding:14px 26px;cursor:pointer;box-shadow:0 4px 20px rgba(93,190,94,.5);z-index:100;transition:transform .2s;}
.collect-btn:hover{transform:translateY(-2px);}
.map-ol{position:fixed;inset:0;background:rgba(0,0,0,.38);backdrop-filter:blur(4px);z-index:200;display:flex;align-items:center;justify-content:flex-end;padding:32px;opacity:0;pointer-events:none;transition:opacity .3s;}
.map-ol.show{opacity:1;pointer-events:all;}
.cpop{background:#fffdf7;border-radius:28px;padding:30px 26px;width:360px;box-shadow:0 20px 60px rgba(0,0,0,.24);position:relative;transform:scale(.85) translateY(20px);transition:transform .35s cubic-bezier(.34,1.4,.64,1);}
.map-ol.show .cpop{transform:scale(1) translateY(0);}
.cpop-x{position:absolute;top:14px;right:16px;width:30px;height:30px;border-radius:50%;background:#eee;border:none;font-size:.95rem;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#666;}
.pr{width:48px;height:48px;border-radius:50%;overflow:hidden;margin:0 auto 10px;border:2px solid #e8e0cc;}
.pr img{width:100%;height:100%;object-fit:cover;}
.pt{font-family:'Gaegu',cursive;font-size:1.3rem;font-weight:700;color:var(--text);text-align:center;margin-bottom:3px;}
.ps{font-size:.73rem;color:#aaa;margin-bottom:18px;text-align:center;}
.pl{display:flex;justify-content:space-between;font-size:.76rem;color:var(--mid);font-weight:700;margin-bottom:6px;}
.pw{background:#e8e0cc;border-radius:20px;height:8px;margin-bottom:22px;overflow:hidden;}
.pf{height:100%;background:linear-gradient(90deg,var(--green),#8bc34a);border-radius:20px;transition:width .8s;}
.ig{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}
.ic{background:#fff;border:2px dashed #d6cdb4;border-radius:18px;padding:14px 8px 12px;text-align:center;position:relative;}
.ic.u{border:2px solid var(--green);box-shadow:0 4px 16px rgba(93,190,94,.22);}
.ii{width:52px;height:52px;margin:0 auto 8px;}
.iname{font-size:.73rem;font-weight:700;color:var(--text);margin-bottom:3px;}
.iclim{font-size:.63rem;color:#bbb;margin-bottom:6px;}
.ibadge{display:inline-block;font-size:.6rem;font-weight:700;padding:3px 10px;border-radius:20px;background:#f0ece0;color:#bbb;}
.ic.u .ibadge{background:#e8f5e9;color:var(--green-d);}
.ilock{position:absolute;inset:0;border-radius:16px;background:rgba(255,255,255,.62);display:flex;align-items:center;justify-content:center;font-size:1.4rem;}
.ic.u .ilock{display:none;}

/* ════ LOADING ════ */
#s-loading{background:#e2e3dc;justify-content:flex-start;padding-top:44px;}
.lt{display:flex;align-items:center;gap:10px;font-family:'Gaegu',cursive;font-size:2rem;font-weight:700;color:var(--text);padding-left:32px;}
.lt .cw{color:var(--orange);}
.lg{width:300px;max-height:70vh;object-fit:contain;margin-top:8px;mix-blend-mode:multiply;}

/* ════ LEARN ════ */
#s-learn{background:#87CEEB;padding:0;align-items:stretch;justify-content:flex-start;}

/* learn 내부는 position:relative 컨테이너로 감쌈 */
.learn-scene{
  position:relative;
  width:100%;height:100%;
  overflow:hidden;
}
.learn-scene-bg{
  position:absolute;inset:0;
  width:100%;height:100%;
  object-fit:cover;
  display:block;
  z-index:0;
}
.learn-topbar{position:absolute;top:0;left:0;right:0;z-index:30;display:flex;align-items:center;justify-content:space-between;padding:10px 14px;}
.learn-brown{height:88px;object-fit:contain;filter:drop-shadow(0 3px 8px rgba(0,0,0,.25));}
.learn-icons{display:flex;align-items:center;gap:8px;}
.learn-icons img{height:46px;object-fit:contain;filter:drop-shadow(0 2px 6px rgba(0,0,0,.25));cursor:pointer;transition:transform .15s;}
.learn-icons img:hover{transform:scale(1.1);}

/* 핫스팟 */
.hs{position:absolute;cursor:pointer;z-index:25;border-radius:50%;transition:background .2s;}
.hs:hover{background:rgba(255,230,0,.15);}
.hs.visited{background:rgba(100,220,100,.1);}

/* 미니 팝업 */
.hpp{position:absolute;z-index:60;background:#fffdf5;border-radius:20px;border:1px solid rgba(0,0,0,.08);box-shadow:0 8px 32px rgba(0,0,0,.28);overflow:hidden;opacity:0;pointer-events:none;transform:scale(.88) translateY(6px);transition:all .28s cubic-bezier(.34,1.4,.64,1);}
.hpp.show{opacity:1;pointer-events:all;transform:scale(1) translateY(0);}
.hpx{position:absolute;top:8px;right:10px;width:24px;height:24px;border-radius:50%;background:#eee;border:none;font-size:.8rem;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#555;z-index:5;}
.hpp img.hpimg{width:100%;display:block;}

/* 토리 */
.tori-wrap{position:absolute;bottom:0;right:1%;width:17%;z-index:40;cursor:pointer;display:flex;flex-direction:column;align-items:center;}
.tori-wrap img.tori-img{width:100%;object-fit:contain;filter:drop-shadow(0 4px 12px rgba(0,0,0,.18));}
.tori-bub{position:absolute;bottom:78%;right:88%;background:#fff;border-radius:16px;padding:10px 14px;font-size:.82rem;font-weight:700;color:#3a3020;box-shadow:0 4px 16px rgba(0,0,0,.16);line-height:1.65;white-space:nowrap;text-align:center;}
.tori-bub::after{content:'';position:absolute;right:-12px;bottom:18px;border:7px solid transparent;border-left-color:#fff;border-right:none;}

/* 완료 오버레이 */
.done-ov{position:absolute;inset:0;background:rgba(240,237,227,.93);z-index:80;display:none;flex-direction:column;align-items:center;justify-content:center;padding:24px 24px 20px;gap:16px;}
.done-ov.show{display:flex;}
.done-title{display:flex;align-items:center;gap:10px;font-family:'Gaegu',cursive;font-size:2rem;font-weight:700;color:var(--text);margin-bottom:20px;}
.done-title .cw{color:var(--orange);}
.done-body{display:flex;align-items:center;justify-content:center;width:100%;max-width:560px;}
.done-tori{height:220px;object-fit:contain;filter:drop-shadow(0 4px 14px rgba(0,0,0,.15));flex-shrink:0;}
.done-bwrap{display:flex;flex-direction:column;align-items:flex-start;padding-top:16px;padding-left:14px;}
.done-bub{background:#fff;border-radius:18px;padding:14px 18px 14px;box-shadow:0 4px 16px rgba(0,0,0,.12);font-size:.85rem;font-weight:700;color:var(--text);line-height:1.6;text-align:center;position:relative;margin-bottom:0;}
.done-bub::before{content:'';position:absolute;left:-12px;top:18px;border:7px solid transparent;border-right-color:#fff;border-left:none;}
.qbtns{display:flex;gap:10px;justify-content:center;margin-top:10px;}
.qbtn{border:none;cursor:pointer;background:none;padding:0;transition:transform .15s;}
.qbtn:hover{transform:scale(1.06);}
.qbtn img{height:42px;object-fit:contain;filter:drop-shadow(0 2px 6px rgba(0,0,0,.15));}
.done-rew{display:flex;align-items:center;gap:12px;background:#fff;border-radius:14px;padding:12px 18px;width:100%;max-width:300px;box-shadow:0 2px 10px rgba(0,0,0,.08);}
.done-ri{width:42px;height:42px;flex-shrink:0;}
.done-rl{font-size:.8rem;font-weight:700;color:var(--text);}
.done-rs{font-size:.66rem;color:#aaa;}
.get-btn{background:var(--green);color:#fff;font-weight:900;font-size:.95rem;border:none;border-radius:40px;padding:12px 36px;cursor:pointer;box-shadow:0 4px 16px rgba(93,190,94,.45);margin-top:14px;transition:transform .2s;}
.get-btn:hover{transform:scale(1.04);}

/* ════ COMPLETE ════ */
#s-complete{background:#f0ede3;justify-content:flex-start;padding:36px 24px 20px;text-align:center;}
.ctit{display:flex;align-items:center;justify-content:center;gap:10px;font-family:'Gaegu',cursive;font-size:2rem;font-weight:700;color:var(--text);margin-bottom:20px;}
.ctit .cw{color:var(--orange);}
.cbody{display:flex;align-items:flex-start;justify-content:center;width:100%;max-width:600px;margin:0 auto;}
.ctori{height:260px;object-fit:contain;filter:drop-shadow(0 4px 16px rgba(0,0,0,.15));flex-shrink:0;}
.cbwrap{display:flex;flex-direction:column;align-items:flex-start;padding-top:20px;padding-left:16px;}
.cbub{background:#fff;border-radius:20px;padding:14px 18px;box-shadow:0 4px 18px rgba(0,0,0,.14);font-size:.88rem;font-weight:700;color:var(--text);line-height:1.6;text-align:left;position:relative;margin-bottom:12px;}
.cbub::before{content:'';position:absolute;left:-14px;top:20px;border:8px solid transparent;border-right-color:#fff;border-left:none;}
.cqbtns{display:flex;gap:10px;align-items:center;}
.cqbtn{border:none;cursor:pointer;background:none;padding:0;transition:transform .15s;}
.cqbtn:hover{transform:scale(1.06);}
.cqbtn img{height:44px;object-fit:contain;filter:drop-shadow(0 2px 6px rgba(0,0,0,.15));}
.crew{display:flex;align-items:center;gap:12px;background:#fff;border-radius:16px;padding:14px 20px;margin:20px auto 0;width:100%;max-width:300px;box-shadow:0 2px 12px rgba(0,0,0,.08);}
.cri{width:44px;height:44px;flex-shrink:0;}
.crl{font-size:.82rem;font-weight:700;color:var(--text);}
.crs{font-size:.68rem;color:#aaa;}
.cgbtn{background:var(--green);color:#fff;font-weight:900;font-size:1rem;border:none;border-radius:50px;padding:14px 40px;cursor:pointer;box-shadow:0 4px 18px rgba(93,190,94,.45);margin-top:16px;transition:transform .2s;}
.cgbtn:hover{transform:scale(1.04);}


/* ════ GIF 전환 화면 ════ */
#s-gif{background:#e2e3dc;justify-content:center;align-items:center;}
.gif-full{
  width:100%;height:100%;
  object-fit:cover;
  position:absolute;inset:0;
}
/* TOAST / FADE */
.toast{position:fixed;top:28px;left:50%;transform:translateX(-50%) translateY(-80px);background:#333;color:#fff;padding:12px 28px;border-radius:50px;font-size:.88rem;font-weight:700;z-index:9999;pointer-events:none;transition:transform .4s cubic-bezier(.34,1.4,.64,1);}
.toast.show{transform:translateX(-50%) translateY(0);}
.fade{position:fixed;inset:0;background:#e2e3dc;z-index:500;opacity:0;pointer-events:none;transition:opacity .4s;}
.fade.in{opacity:1;pointer-events:all;}
</style>
</head>
<body>
<div class="fade" id="fade"></div>
<div class="toast" id="toast"></div>

<!-- ════ MAP ════ -->
<div class="screen active" id="s-map">
  <img class="map-bg" src="data:image/png;base64," alt="지도">
  <img class="pin" src="data:image/png;base64," style="left:17%;top:13%" data-key="cold">
  <img class="pin" src="data:image/png;base64," style="left:73%;top:11%" data-key="cold">
  <img class="pin" src="data:image/png;base64," style="left:47%;top:23%" data-key="temp">
  <img class="pin" src="data:image/png;base64," style="left:55%;top:43%" data-key="dry">
  <img class="pin" src="data:image/png;base64," style="left:46%;top:60%" data-key="trop">
  <img class="pin" src="data:image/png;base64," style="left:23%;top:63%" data-key="trop">
  <button class="collect-btn" onclick="openCollect()">모은 재료 보기</button>
  <div class="rabbit-wrap">
    <div class="map-bubble" id="mapBubble">
      다양한 기후의 재료를<br>다 모아 봐야지! 🐾<br>
      <span style="color:var(--green-d);font-size:.76rem">탐험하고 싶은 지역을<br>클릭해 봐!</span>
    </div>
    <div class="rabbit-btn" onclick="toggleMapBubble()"><img src="data:image/png;base64," alt="토끼"></div>
  </div>
  <div class="map-ol" id="collectOl" onclick="closeCollectBg(event)">
    <div class="cpop">
      <button class="cpop-x" onclick="closeCollect()">✕</button>
      <div class="pr"><img src="data:image/png;base64," alt="토끼"></div>
      <div class="pt">토끼의 요리 재료 도장판</div>
      <div class="ps">기후를 학습하고 도장을 모아봐요!</div>
      <div class="pl"><span>수집 진행도</span><span id="progTxt">0 / 4 완료</span></div>
      <div class="pw"><div class="pf" id="progFill" style="width:0%"></div></div>
      <div class="ig" id="ingGrid"></div>
    </div>
  </div>
</div>

<!-- ════ LOADING ════ -->
<div class="screen" id="s-loading">
  <div class="lt">🌴 <span><span class="cw">열대 기후</span>로 떠나는 중…</span></div>
  <img class="lg" src="data:image/gif;base64," alt="토리">
</div>


<!-- ════ GIF ════ -->
<div class="screen" id="s-gif">
  <img class="gif-full" src="data:image/gif;base64," alt="열대기후 애니">
</div>

<!-- ════ LEARN ════ -->
<div class="screen" id="s-learn">
  <div class="learn-scene">
    <!-- 배경 이미지 -->
    <img class="learn-scene-bg" src="data:image/png;base64," alt="열대기후">

    <!-- 상단 바 -->
    <div class="learn-topbar">
      <img class="learn-brown" src="data:image/png;base64," alt="열대 기후 (브라질 마나우스)">
      <div class="learn-icons">
        <img src="data:image/png;base64," alt="홈" onclick="goHome()">
        <img src="data:image/png;base64," alt="소리">
        <img src="data:image/png;base64," alt="뒤로" onclick="goHome()">
      </div>
    </div>

    <!-- 핫스팟 -->
    <div class="hs" id="hs1" style="left:2%;top:38%;width:19%;height:55%;" onclick="clickHs(1)"></div>
    <div class="hs" id="hs2" style="left:20%;top:14%;width:40%;height:52%;" onclick="clickHs(2)"></div>
    <div class="hs" id="hs3" style="right:1%;top:2%;width:26%;height:46%;" onclick="clickHs(3)"></div>

    <!-- 팝업 -->
    <div class="hpp" id="hp1" style="left:20%;top:32%;width:380px;">
      <button class="hpx" onclick="closeHp(1)">✕</button>
      <img class="hpimg" src="data:image/png;base64," alt="열대 기후의 음식">
    </div>
    <div class="hpp" id="hp2" style="left:28%;top:30%;width:360px;">
      <button class="hpx" onclick="closeHp(2)">✕</button>
      <div style="padding:20px 18px 18px">
        <h3 style="font-family:'Gaegu',cursive;font-size:1.15rem;text-align:center;margin-bottom:10px;color:#3a3020">🏠 열대 기후의 집</h3>
        <p style="font-size:.8rem;color:#555;line-height:1.75">열대 지역에서는 높은 기온과 습기를 피하기 위해 바닥을 높인 <b>고상 가옥</b>에서 살아요.</p>
      </div>
    </div>
    <div class="hpp" id="hp3" style="right:4%;top:28%;width:360px;">
      <button class="hpx" onclick="closeHp(3)">✕</button>
      <div style="padding:20px 18px 18px">
        <h3 style="font-family:'Gaegu',cursive;font-size:1.15rem;text-align:center;margin-bottom:10px;color:#3a3020">🐦 열대 기후의 동물</h3>
        <p style="font-size:.8rem;color:#555;line-height:1.75">열대우림에는 앵무새, 투칸, 재규어 등 다양한 동물이 살아요.</p>
      </div>
    </div>

    <!-- 토리 -->
    <div class="tori-wrap" id="toriWrap" onclick="toggleLearnBubble()">
      <div class="tori-bub" id="toriBubble">
        노란색 표시선 안 그림을 클릭해서<br>
        <span style="color:#E8862A">열대 기후 사람들의</span><br>
        생활 모습을 알아보자!
      </div>
      <img class="tori-img" src="data:image/png;base64," alt="토리">
    </div>

    <!-- 완료 오버레이 -->
    <div class="done-ov" id="doneOv">
      <div class="done-title">🌴 <span><span class="cw">열대 기후</span> 탐험 완료!</span></div>
      <div class="done-body">
        <img class="done-tori" src="data:image/png;base64," alt="토리">
        <div class="done-bwrap">
          <div class="done-bub">
            퀴즈를 풀고 재료를 더 얻어 볼래?
            <div class="qbtns">
              <button class="qbtn" onclick="toast('🚧 퀴즈 준비 중이에요!')"><img src="data:image/png;base64," alt="좋아요"></button>
              <button class="qbtn" onclick="finishLearn()"><img src="data:image/png;base64," alt="괜찮아요"></button>
            </div>
          </div>
        </div>
      </div>
      <div class="done-rew">
        <div class="done-ri"><svg viewBox="0 0 52 52" fill="none"><defs><linearGradient id="cg" x1="13" y1="13" x2="39" y2="47"><stop offset="0%" stop-color="#A0522D"/><stop offset="100%" stop-color="#5C2A0A"/></linearGradient></defs><ellipse cx="26" cy="31" rx="13" ry="16" fill="url(#cg)"/><path d="M20 16 Q20 31 20 46" stroke="#7B3A14" stroke-width="1.5" stroke-linecap="round"/><path d="M26 15 Q26 31 26 47" stroke="#7B3A14" stroke-width="1.5" stroke-linecap="round"/><path d="M32 16 Q32 31 32 46" stroke="#7B3A14" stroke-width="1.5" stroke-linecap="round"/><rect x="24" y="8" width="4" height="8" rx="2" fill="#5D8A3C"/><ellipse cx="34" cy="9" rx="9" ry="5" fill="#5D8A3C" transform="rotate(-22 34 9)"/></svg></div>
        <div><div class="done-rl">카카오</div><div class="done-rs">탐험 보상 재료</div></div>
      </div>
      <button class="get-btn" onclick="collectReward()">🎁 재료 획득하기!</button>
    </div>
</div>

<!-- ════ COMPLETE ════ -->
<div class="screen" id="s-complete">
  <div class="ctit">🌴 <span><span class="cw">열대 기후</span> 탐험 완료!</span></div>
  <div class="cbody">
    <img class="ctori" src="data:image/png;base64," alt="토리">
    <div class="cbwrap">
      <div class="cbub">퀴즈를 풀고 재료를 더 얻어 볼래?</div>
      <div class="cqbtns">
        <button class="cqbtn" onclick="toast('🚧 퀴즈 준비 중!')"><img src="data:image/png;base64," alt="좋아요"></button>
        <button class="cqbtn" onclick="goHome()"><img src="data:image/png;base64," alt="괜찮아요"></button>
      </div>
    </div>
  </div>
  <div class="crew">
    <div class="cri"><svg viewBox="0 0 52 52" fill="none"><defs><linearGradient id="cg2" x1="13" y1="13" x2="39" y2="47"><stop offset="0%" stop-color="#A0522D"/><stop offset="100%" stop-color="#5C2A0A"/></linearGradient></defs><ellipse cx="26" cy="31" rx="13" ry="16" fill="url(#cg2)"/><path d="M20 16 Q20 31 20 46" stroke="#7B3A14" stroke-width="1.5" stroke-linecap="round"/><path d="M26 15 Q26 31 26 47" stroke="#7B3A14" stroke-width="1.5" stroke-linecap="round"/><path d="M32 16 Q32 31 32 46" stroke="#7B3A14" stroke-width="1.5" stroke-linecap="round"/><rect x="24" y="8" width="4" height="8" rx="2" fill="#5D8A3C"/><ellipse cx="34" cy="9" rx="9" ry="5" fill="#5D8A3C" transform="rotate(-22 34 9)"/></svg></div>
    <div><div class="crl">카카오</div><div class="crs">탐험 보상 재료</div></div>
  </div>
  <button class="cgbtn" onclick="collectReward()">🎁 재료 획득하기!</button>
</div>

<script>
var collected={trop:false,dry:false,temp:false,cold:false};
var learnVisited=new Set();
var mapBubOn=true, learnBubOn=true;

var svgI={
  trop:'<svg viewBox="0 0 52 52" fill="none"><defs><linearGradient id="g1" x1="13" y1="13" x2="39" y2="47"><stop offset="0%" stop-color="#A0522D"/><stop offset="100%" stop-color="#5C2A0A"/></linearGradient></defs><ellipse cx="26" cy="31" rx="13" ry="16" fill="url(#g1)"/><path d="M20 16 Q20 31 20 46" stroke="#7B3A14" stroke-width="1.5" stroke-linecap="round"/><path d="M26 15 Q26 31 26 47" stroke="#7B3A14" stroke-width="1.5" stroke-linecap="round"/><path d="M32 16 Q32 31 32 46" stroke="#7B3A14" stroke-width="1.5" stroke-linecap="round"/><rect x="24" y="8" width="4" height="8" rx="2" fill="#5D8A3C"/><ellipse cx="34" cy="9" rx="9" ry="5" fill="#5D8A3C" transform="rotate(-22 34 9)"/></svg>',dry:'<svg viewBox="0 0 52 52" fill="none"><rect x="23" y="30" width="6" height="18" rx="3" fill="#C4933F"/><path d="M26 30 Q18 21 10 17" stroke="#5A8A3C" stroke-width="3" stroke-linecap="round" fill="none"/><path d="M26 30 Q31 19 33 9" stroke="#5A8A3C" stroke-width="3" stroke-linecap="round" fill="none"/><path d="M26 30 Q34 21 42 17" stroke="#5A8A3C" stroke-width="3" stroke-linecap="round" fill="none"/><circle cx="22" cy="32" r="3.2" fill="#C86820"/><circle cx="28" cy="31" r="3.2" fill="#D47828"/><circle cx="25" cy="35" r="3.2" fill="#BC6018"/></svg>',temp:'<svg viewBox="0 0 52 52" fill="none"><path d="M26 48 Q26 32 26 18" stroke="#8B6914" stroke-width="3" stroke-linecap="round"/><path d="M26 32 Q18 26 12 21" stroke="#8B6914" stroke-width="2.2" stroke-linecap="round"/><path d="M26 25 Q34 19 40 15" stroke="#8B6914" stroke-width="2.2" stroke-linecap="round"/><ellipse cx="15" cy="20" rx="8" ry="3.2" fill="#7AAA40" transform="rotate(-35 15 20)"/><ellipse cx="37" cy="14" rx="8" ry="3.2" fill="#7AAA40" transform="rotate(28 37 14)"/><ellipse cx="19" cy="28" rx="4.2" ry="6" fill="#4A7038"/><ellipse cx="32" cy="21" rx="4.2" ry="6" fill="#5A8040"/><ellipse cx="26" cy="36" rx="4.2" ry="6" fill="#4A7038"/></svg>',cold:'<svg viewBox="0 0 52 52" fill="none"><defs><linearGradient id="g2" x1="2" y1="18" x2="46" y2="38"><stop offset="0%" stop-color="#F09070"/><stop offset="100%" stop-color="#C03830"/></linearGradient></defs><path d="M8 27 Q20 17 38 23 Q44 25 46 27 Q44 29 38 31 Q20 37 8 27Z" fill="url(#g2)"/><path d="M8 27 L1 19 L1 35 Z" fill="#D05040"/><circle cx="40" cy="26.5" r="3.2" fill="#fff"/><circle cx="40" cy="26.5" r="2" fill="#1a1a1a"/></svg>'
};
var clim={
  trop:{n:'열대기후',i:'카카오'},dry:{n:'건조기후',i:'대추야자'},
  temp:{n:'온대기후',i:'올리브'},cold:{n:'냉대기후',i:'연어'}
};

function go(id,cb){
  var f=document.getElementById('fade');
  f.classList.add('in');
  setTimeout(function(){
    if(cb)cb();
    document.querySelectorAll('.screen').forEach(function(s){s.classList.remove('active');});
    document.getElementById(id).classList.add('active');
    setTimeout(function(){f.classList.remove('in');},400);
  },400);
}

// MAP
document.querySelectorAll('.pin').forEach(function(p){
  p.addEventListener('click',function(){
    if(p.dataset.key==='trop')startJourney();
    else toast('🚧 준비 중인 기후예요!');
  });
});
function toggleMapBubble(){
  var b=document.getElementById('mapBubble');
  mapBubOn=!mapBubOn;b.style.display=mapBubOn?'block':'none';
}
function openCollect(){renderIng();document.getElementById('collectOl').classList.add('show');}
function closeCollect(){document.getElementById('collectOl').classList.remove('show');}
function closeCollectBg(e){if(e.target===document.getElementById('collectOl'))closeCollect();}
function renderIng(){
  var keys=['trop','dry','temp','cold'];
  var done=keys.filter(function(k){return collected[k];}).length;
  document.getElementById('progTxt').textContent=done+' / 4 완료';
  document.getElementById('progFill').style.width=(done/4*100)+'%';
  document.getElementById('ingGrid').innerHTML=keys.map(function(k){
    var c=clim[k],u=collected[k];
    return '<div class="ic'+(u?' u':'')+'"><div class="ii">'+svgI[k]+'</div>'
      +'<div class="iname">'+c.i+'</div><div class="iclim">'+c.n+'</div>'
      +'<div class="ibadge">'+(u?'✓ 획득 완료':'탐험 대기 중...')+'</div>'
      +(u?'':'<div class="ilock">🔒</div>')+'</div>';
  }).join('');
}

// JOURNEY
function startJourney(){
  go('s-loading',function(){learnVisited.clear();});
  setTimeout(function(){
    go('s-gif',function(){});
    setTimeout(function(){
      go('s-learn',function(){
      var tb=document.getElementById('toriBubble');
      tb.style.display='block';tb.style.opacity='1';tb.style.transition='';learnBubOn=true;
      setTimeout(function(){
        tb.style.transition='opacity .4s';tb.style.opacity='0';
        setTimeout(function(){tb.style.display='none';learnBubOn=false;tb.style.transition='';},400);
      },4000);
      });
    },2500);
  },2800);
}

// LEARN
function toggleLearnBubble(){
  var tb=document.getElementById('toriBubble');
  learnBubOn=!learnBubOn;
  tb.style.transition='';tb.style.opacity='1';
  tb.style.display=learnBubOn?'block':'none';
}
function clickHs(n){
  closeAllHp();
  document.getElementById('hp'+n).classList.add('show');
  document.getElementById('hs'+n).classList.add('visited');
  learnVisited.add(n);
  if(learnVisited.size>=3){
    setTimeout(function(){closeAllHp();document.getElementById('doneOv').classList.add('show');},700);
  }
}
function closeHp(n){document.getElementById('hp'+n).classList.remove('show');}
function closeAllHp(){document.querySelectorAll('.hpp').forEach(function(p){p.classList.remove('show');});}
function finishLearn(){document.getElementById('doneOv').classList.remove('show');learnVisited.clear();go('s-map');}
function goHome(){go('s-map');}

// REWARD
function collectReward(){
  if(collected.trop){toast('이미 획득한 재료예요!');return;}
  collected.trop=true;
  toast('🎉 카카오를 획득했어요!');
  setTimeout(function(){go('s-map');},1200);
}

// TOAST
function toast(msg){
  var t=document.getElementById('toast');
  t.textContent=msg;t.classList.add('show');
  setTimeout(function(){t.classList.remove('show');},2600);
}

// map bubble 자동 숨김
setTimeout(function(){
  var b=document.getElementById('mapBubble');
  b.style.transition='opacity .4s';b.style.opacity='0';
  setTimeout(function(){b.style.display='none';mapBubOn=false;},400);
},6000);

renderIng();
</script>
</body>
</html>
